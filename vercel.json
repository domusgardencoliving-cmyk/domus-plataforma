{
  "version": 2,
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/reservar",
      "destination": "/reservar.html"
    },
    {
      "source": "/minha-conta",
      "destination": "/minha-conta.html"
    },
    {
      "source": "/dominhas",
      "destination": "/dominhas.html"
    },
    {
      "source": "/cleaner",
      "destination": "/cleaner.html"
    },
    {
      "source": "/limpeza",
      "destination": "/cleaner.html"
    },
    {
      "source": "/atrio",
      "destination": "/sala-conversas.html"
    },
    {
      "source": "/sala-conversas",
      "destination": "/sala-conversas.html"
    },
    {
      "source": "/instalar",
      "destination": "/instalar.html"
    },
    {
      "source": "/pms",
      "destination": "/index.html?login=pms"
    },
    {
      "source": "/dg",
      "destination": "/index.html?login=dg"
    },
    {
      "source": "/admin",
      "destination": "/index.html?login=dg"
    },
    {
      "source": "/conectar-canais",
      "destination": "/conectar-canais.html"
    },
    {
      "source": "/auditoria-pms",
      "destination": "/auditoria-pms.html"
    },
    {
      "source": "/boletos-mes",
      "destination": "/boletos-mes.html"
    },
    {
      "source": "/boletos",
      "destination": "/boletos-mes.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*\\.html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/(pms|dg|admin|atrio|dominhas|reservar|minha-conta|cleaner|limpeza|conectar-canais|auditoria-pms|boletos-mes|agendar-visita|lista-espera)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}